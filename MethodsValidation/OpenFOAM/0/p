FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0; 

boundaryField
{
    x0
    {
        type            fixedValue;
        value           uniform 0.008;
    }

    xL
    {
        type            fixedValue;
        value           uniform 0.0;
    }

    "(y0|yL)"
    {
        type            symmetry;     
    }

    "(z0|zL)"
    {
        type            empty;     
    }

    spheres
    {
        type            zeroGradient;        
    }
}
