FoamFile
{
    version       2.0;  
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoamMod;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         150000;

deltaT          1;

writeControl    timeStep;

writeInterval   5000;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
  volumeIntegrals
  {
     type            volFieldValue;
     libs            ("libfieldFunctionObjects.so");
     log             true;
     writeControl    writeTime;
     enabled         true;
     writeFields     true;
     regionType      cellZone;
     name 	         water;
     operation       volIntegrate;
     fields
     (
         U
         p
     );
  }

  surfaceIntegrals
  {
     type            surfaceFieldValue;
     libs            ("libfieldFunctionObjects.so");
     log             true;
     writeControl    writeTime;
     writeFields     false;
     regionType      patch;
     name 	         spheres;
     operation       areaIntegrate;
     fields
     (
      gradUn
      pn
      n
     );
  }
}

