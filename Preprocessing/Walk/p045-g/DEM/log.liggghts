thermo_log      ../DEM/post/thermo.txt
include         ../DEM/in.DEM
# Particle and Domain Properties for DEM

#--------------------------Domain Properties--------------------------#

variable Lx equal 31.510819
variable Ly equal 31.510819
variable Lz equal 31.510819

#-------------------------Particle Properties-------------------------#

#variable nrPart   equal 42    # Number of particles
#variable R        equal .5
variable rhos     equal 1.0   # density of particles
variable g        equal 0.0   # gravity
#variable dx       equal .03   # for lubrication correction cutoff
#variable mu       equal .01 # fluid viscosity for lubrication
#variable seed     equal 100003 # initial pack seed

#-------------------------Simulation Settings-------------------------#

variable xProc     equal   1      # processor sections in x direction
variable yProc     equal   1      # processor sections in y direction
variable zProc     equal   1      # processor sections in z direction

variable timeStep  equal 	 0.00003 		#[s]		simulation timestep DEM
variable numTS     equal 	 1000000 		#[s]		simulation timestep DEM

atom_style      granular
atom_modify     map array
communicate     single vel yes

boundary        p p p
newton          off

units           si
processors      ${xProc} ${yProc} ${zProc}
processors      1 ${yProc} ${zProc}
processors      1 1 ${zProc}
processors      1 1 1

region          reg block 0. ${Lx} 0. ${Ly} 0. ${Lz} units box
region          reg block 0. 31.510819 0. ${Ly} 0. ${Lz} units box
region          reg block 0. 31.510819 0. 31.510819 0. ${Lz} units box
region          reg block 0. 31.510819 0. 31.510819 0. 31.510819 units box
create_box      1 reg
Created orthogonal box = (0 0 0) to (31.5108 31.5108 31.5108)
  1 by 1 by 1 MPI processor grid

neighbor        1.3 bin
neigh_modify    delay 0 binsize 0.1

# Material properties required for new pair styles

fix             m1 all property/global youngsModulus peratomtype 5.e7
fix             m2 all property/global poissonsRatio peratomtype 0.45
fix             m3 all property/global coefficientRestitution peratomtypepair 1 0.9
fix             m4 all property/global coefficientFriction peratomtypepair 1 0.5

# pair style
pair_style      gran model hertz tangential history #Hertzian without cohesion
pair_coeff      * *

# timestep, gravity
timestep        ${timeStep}
timestep        3e-05
fix             gravi all gravity $g vector 0.0 0.0 -1.0
fix             gravi all gravity 0 vector 0.0 0.0 -1.0

# walls
#fix     xwalls1 all wall/gran model hertz tangential history primitive type 1 xplane 0.
#fix     xwalls2 all wall/gran model hertz tangential history primitive type 1 xplane ${Lx}
#fix     ywalls1 all wall/gran model hertz tangential history primitive type 1 yplane 0.
#fix     ywalls2 all wall/gran model hertz tangential history primitive type 1 yplane ${Ly}
#fix     zwalls1 all wall/gran model hertz tangential history primitive type 1 zplane 0.
#fix     zwalls2 all wall/gran model hertz tangential history primitive type 1 zplane ${Lz}

# create single particles
#fix         pts1 all particletemplate/sphere 1 atom_type 1 density constant ${rhos} radius constant $R
#fix         pdd1 all particledistribution/discrete 1 1 pts1 1.0
#fix         ins all insert/pack seed ${seed} distributiontemplate pdd1 vel constant 0. 0. 0. insert_every ${numTS} overlapcheck yes all_in yes particles_in_region ${nrPart} region reg

include ../DEM/in.poly1
