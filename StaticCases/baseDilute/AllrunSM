#!/bin/sh
#cd ${0%/*} || exit 1    # Run from this directory

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Body forces to run
g_=( .0001 .0002 .0003 .0005
     .001  .002  .003  .005
     .01   .025  .05   .075
     .1    .25   .5    .75)


ng=15

for i in $(seq ${ng} ${ng})
do
    # Preprocess
    echo ${g_[i]}
    sed -i "18s/.*/value           (-${g_[i]} 0 0);/" ./constant/g

    # Prep for simpleFoam
    cp ./system/fvSchemes-sf ./system/fvSchemes
    cp ./system/fvSolution-sf ./system/fvSolution
    cp ./system/controlDict-sf ./system/controlDict
    # Run the thing
    srun simpleFoamMod -parallel > ${1}/log.simpleFoamMod${i}
    # Save results
    mv postProcessing post${i}-sf

    # Prep for pimpleFoam
    cp ./system/fvSchemes-pf ./system/fvSchemes
    cp ./system/fvSolution-pf ./system/fvSolution
    cp ./system/controlDict-pf ./system/controlDict
    # Run pimpleFoam
    srun pimpleFoamMod -parallel > ${1}/log.pimpleFoamMod${i}
    # Save results
    mv postProcessing post${i}-pf
done

