FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-9;
        relTol          0;
    }

    pFinal
    {
        $p;
        relTol          0;
    }

    "(U)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-9;
        relTol          0;
    }

    "(U)Final"
    {
        $U;
        relTol          0;
    }
}

PIMPLE
{
    momentumPredictor   off;
    nOuterCorrectors    2000;
    nCorrectors         3;
    nNonOrthogonalCorrectors 0;
    pRefCell            0;
    pRefValue           0;
    turbOnFinalIterOnly no;
    outerCorrectorResidualControl
    {
        p   
        { 
            tolerance   1e-7;
            relTol     0.0;
        }
        U   
        {
            tolerance   1e-7;
            relTol     0.0;
        }
    }
}

relaxationFactors
{
    equations
    {
        ".*"   1;
    }
}

