#!/bin/sh
#cd ${0%/*} || exit 1    # Run from this directory

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Body forces to run
g_=( 100 250 500 750)

let ng=4-1

for i in $(seq 0 ${ng})
do
    # Preprocess
    echo ${g_[i]}
    sed -i "18s/.*/value           (-${g_[i]} 0 0);/" ./constant/g
    # Run the thing
    srun simpleFoamMod -parallel > ${1}/log.simpleFoamMod${i}b
    # Save results
    mv postProcessing post${i}b
done

