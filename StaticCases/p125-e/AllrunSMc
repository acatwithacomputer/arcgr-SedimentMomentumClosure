#!/bin/sh
#cd ${0%/*} || exit 1    # Run from this directory

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Body forces to run
g_=(400000 600000 700000 300000 200000
    550000 450000)

let ng=7-1

for i in $(seq 3 ${ng})
do
    # Preprocess
    echo ${g_[i]}
    sed -i "18s/.*/value           (-${g_[i]} 0 0);/" ./constant/g
    # Run the thing
    srun simpleFoamMod -parallel > ${1}/log.simpleFoamMod${i}c
    # Save results
    mv postProcessing post${i}c
done

