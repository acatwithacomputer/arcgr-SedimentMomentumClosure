FoamFile
{
    version       2.0;  
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoamMod;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         100; //00; //150000;

deltaT          1;

writeControl    timeStep;

writeInterval   500; //5000;

purgeWrite      2;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   12;

runTimeModifiable true;


